---
import Base from "../layouts/Base.astro";
import LangToggle from "../components/LangToggle.astro";
import Footer from "../components/Footer.astro";
import { ui } from "../i18n/ui";
---

<Base>
  <LangToggle />

  <main class="page">
    <header class="head">
      <h1>tegmora<span class="period">.</span></h1>
    </header>

    <p
      class="intro"
      data-en={ui.intro1.en}
      data-tr={ui.intro1.tr}
      set:html={ui.intro1.en}
    />
    <p
      class="intro"
      data-en={ui.intro2.en}
      data-tr={ui.intro2.tr}
      set:html={ui.intro2.en}
    />
    <p
      class="intro"
      data-en={ui.intro3.en}
      data-tr={ui.intro3.tr}
      set:html={ui.intro3.en}
    />

    <section class="sec">
      <div class="sec-head">
        <h2 data-en={ui.appsHeading.en} data-tr={ui.appsHeading.tr}>
          {ui.appsHeading.en}
        </h2>
        <div class="rule"></div>
      </div>
      <a class="app-card" href="/apps/excerpta/">
        <img
          class="app-card-icon"
          src="/apps/excerpta/icon-112.png"
          alt=""
          width="56"
          height="56"
        />
        <div class="app-info">
          <h3>Excerpta</h3>
          <p data-en={ui.excerptaBlurb.en} data-tr={ui.excerptaBlurb.tr}>
            {ui.excerptaBlurb.en}
          </p>
          <span
            class="app-more"
            data-en={ui.excerptaMore.en}
            data-tr={ui.excerptaMore.tr}>{ui.excerptaMore.en}</span
          >
        </div>
      </a>
    </section>

    <section class="sec">
      <div class="sec-head">
        <h2 data-en={ui.contactHeading.en} data-tr={ui.contactHeading.tr}>
          {ui.contactHeading.en}
        </h2>
        <div class="rule"></div>
      </div>
      <p
        class="contact-line"
        data-en={ui.contactLine.en}
        data-tr={ui.contactLine.tr}
        set:html={ui.contactLine.en}
      />
      <!-- <p class="contact-sub">hello@tegmora.com &nbsp;·&nbsp; Ankara, Türkiye</p> -->
    </section>

    <Footer />
  </main>
</Base>
